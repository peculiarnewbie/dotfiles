#!/usr/bin/env bash
# Dotfiles installer
# Symlinks configs from this repo into their expected locations.
# Run from the repo root, or from anywhere (it resolves its own location).

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOME_DIR="$HOME"
CONFIG_DIR="${HOME_DIR}/.config"
BACKUP_DIR="${HOME_DIR}/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

# Files at repo root that should live directly in $HOME.
home_files=(
    .bashrc
    .gitconfig
    .ideavimrc
    .profile
    .wezterm.lua
    .zprofile
    .zshrc
    kanata.kbd
    kanata-linux.kbd
    sunshine.conf
    whkdrc
    xremap.yml
)

# Files at repo root that should live in ~/.config/.
config_files=(
    starship.toml
)

# Files that live under ~/.config/ but not at the root.
# Format: repo/path:relative/path/under/.config
config_nested_files=(
    noctalia/settings.json:noctalia/settings.json
    noctalia/plugins.json:noctalia/plugins.json
    noctalia/colors.json:noctalia/colors.json
    fish/config.fish:fish/config.fish
)

# Directories that should be symlinked under $HOME but not at the root.
# Format: repo/path:relative/path/under/$HOME
home_dirs=(
    wallpapers:Pictures/Wallpapers
)

# Directories in the repo that should be symlinked as ~/.config/<name>.
config_dirs=(
    ghostty
    hyprland
    niri
    nvim
    oh-my-posh
    pi
    powershell
    yazi
    Zed
)

# systemd user units to symlink into ~/.config/systemd/user/.
# We do this per-file so we don't blow away other user units.
systemd_user_units=(
    user/ssh-agent.service
    user/noctalia-shell.service
)

# systemd system units to symlink into /etc/systemd/system/.
# These require root (e.g. kanata needs /dev/uinput). Run install with sudo
# or pre-link these manually. We skip them silently if not running as root.
systemd_system_units=(
    kanata.service
)

log() {
    printf '  %b%s%b\n' "$2" "$1" '\033[0m'
}

backup() {
    local target="$1"
    # Preserve relative directory structure inside backup dir to avoid
    # basename collisions when backing up files from different directories.
    local rel="${target#$HOME_DIR/}"
    local backup_path="$BACKUP_DIR/$rel"
    mkdir -p "$(dirname "$backup_path")"
    mv "$target" "$backup_path"
    log "Backed up $target -> $backup_path" '\033[33m'
}

link_file() {
    local src="$1"
    local dst="$2"

    if [[ -L "$dst" ]]; then
        if [[ "$(readlink -f "$dst")" == "$(readlink -f "$src")" ]]; then
            log "Already linked: $dst" '\033[90m'
            return
        fi
        rm "$dst"
    elif [[ -e "$dst" ]]; then
        backup "$dst"
    fi

    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    log "Linked: $dst -> $src" '\033[32m'
}

link_dir() {
    local src="$1"
    local dst="$2"

    if [[ -L "$dst" ]]; then
        if [[ "$(readlink -f "$dst")" == "$(readlink -f "$src")" ]]; then
            log "Already linked: $dst" '\033[90m'
            return
        fi
        rm "$dst"
    elif [[ -e "$dst" ]]; then
        backup "$dst"
    fi

    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    log "Linked: $dst -> $src" '\033[32m'
}

main() {
    echo "Installing dotfiles from $REPO"
    echo "Backups will go to $BACKUP_DIR"
    echo

    for file in "${home_files[@]}"; do
        link_file "$REPO/$file" "$HOME_DIR/$file"
    done

    for file in "${config_files[@]}"; do
        link_file "$REPO/$file" "$CONFIG_DIR/$file"
    done

    for entry in "${config_nested_files[@]}"; do
        local src_rel="${entry%%:*}"
        local dst_rel="${entry#*:}"
        link_file "$REPO/$src_rel" "$CONFIG_DIR/$dst_rel"
    done

    for entry in "${home_dirs[@]}"; do
        local src_rel="${entry%%:*}"
        local dst_rel="${entry#*:}"
        link_dir "$REPO/$src_rel" "$HOME_DIR/$dst_rel"
    done

    for dir in "${config_dirs[@]}"; do
        link_dir "$REPO/$dir" "$CONFIG_DIR/$dir"
    done

    mkdir -p "$CONFIG_DIR/systemd/user"
    for unit in "${systemd_user_units[@]}"; do
        local src_unit="$REPO/systemd/$unit"
        if [[ -f "$src_unit" ]]; then
            link_file "$src_unit" "$CONFIG_DIR/systemd/user/$unit"
        else
            log "Skipped missing unit: $src_unit" '\033[31m'
        fi
    done

    if [[ "$EUID" -eq 0 ]]; then
        local sys_unit_dir="/etc/systemd/system"
        for unit in "${systemd_system_units[@]}"; do
            local src_unit="$REPO/systemd/$unit"
            if [[ -f "$src_unit" ]]; then
                link_file "$src_unit" "$sys_unit_dir/$unit"
            else
                log "Skipped missing unit: $src_unit" '\033[31m'
            fi
        done
    else
        echo
        log "Skipped system units (run as root to install): ${systemd_system_units[*]}" '\033[33m'
        echo "  sudo $REPO/install   # or link manually into /etc/systemd/system/"
    fi

    echo
    echo "Done."
    echo "You may need to run: systemctl --user daemon-reload"
    echo "And enable services: systemctl --user enable --now ssh-agent.service"
    if [[ "$EUID" -eq 0 ]]; then
        echo "System units installed. Run: systemctl daemon-reload && systemctl enable --now kanata"
    fi
}

main "$@"
