# Config generated by Ghostty Config

clipboard-read = allow
clipboard-write = allow
window-decoration = false
gtk-wide-tabs = false
font-size = 10
shell-integration = zsh
window-save-state = always
gtk-custom-css = /home/bolt/.config/ghostty/custom-bar.css


# Pane management is handled by Herdr (direct alt chords).
# Ghostty keeps only window-level actions behind an alt+g prefix.

# alt+g prefix, then a key:
keybind = alt+g>t=new_tab
keybind = alt+g>d=next_tab
keybind = alt+g>a=previous_tab
keybind = alt+g>r=reload_config
keybind = alt+g>q=close_surface

# Pass alt+g through to the shell if pressed twice.
keybind = alt+g>alt+g=text:\x1bg

theme = Detuned

window-padding-balance = true
window-padding-x = 0
window-padding-y = 0
window-padding-color = extend

command = /usr/bin/zsh
